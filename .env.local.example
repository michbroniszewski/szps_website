# Szablon .env dla LOKALNEGO środowiska testowego.
#
# Użycie:
#   1) skopiuj do .env:   cp .env.local.example .env
#   2) wygeneruj SECRET_KEY i wklej niżej:
#        python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#   3) uruchom setup:     bash scripts/local-dev-setup.sh
#
# W trybie lokalnym używamy SQLite (plik db.sqlite3 w katalogu projektu),
# NIE łączymy się z bazą produkcyjną na mydevil.

DJANGO_SECRET_KEY=zamien-mnie-na-losowy-ciag-znakow
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Pusty DB_ENGINE / "sqlite" = SQLite. Nie wpisuj tu danych produkcyjnych.
DB_ENGINE=sqlite
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
