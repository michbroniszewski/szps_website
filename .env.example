# Skopiuj do .env i uzupełnij. Plik .env NIE jest commitowany.
# Wygeneruj klucz: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Baza danych: pusto = SQLite (lokalny dev), wpisane = PostgreSQL (produkcja)
DB_ENGINE=sqlite
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# Przykład produkcji (mydevil):
# DJANGO_SECRET_KEY=<wygenerowany>
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=sedziowie.szps.pl,www.sedziowie.szps.pl
# DB_ENGINE=postgresql
# DB_NAME=f1448_sedziowie
# DB_USER=f1448_sedziowie
# DB_PASSWORD=<hasło do bazy>
# DB_HOST=pgsql4.mydevil.net
# DB_PORT=5432

# Formularz kontaktowy — wysyłka przez SMTP mydevil.
# Wymaga wcześniej założonej skrzynki w panelu mydevil.net (Poczta →
# Konta pocztowe → "ws@szps.pl"). Domena musi mieć rekordy DKIM/SPF
# ustawione przez mydevil, inaczej Gmail zablokuje wiadomości.
#
# EMAIL_HOST=smtp.mydevil.net
# EMAIL_PORT=587
# EMAIL_HOST_USER=ws@szps.pl
# EMAIL_HOST_PASSWORD=<hasło do skrzynki>
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# DJANGO_FROM_EMAIL=Formularz ŚZPS <ws@szps.pl>
# CONTACT_RECIPIENT=ws@szps.pl
